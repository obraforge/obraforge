---
import Carimbo from '../../components/Carimbo.astro';
import Install from '../../components/Install.astro';
import Base from '../../layouts/Base.astro';
import { catalog, expected, firstSentence, fixtureInput, normas, REPO_URL, skillBody, type Skill } from '../../lib/catalog.js';
import { renderMarkdown } from '../../lib/markdown.js';

export function getStaticPaths() {
  return catalog().skills.map((skill) => ({ params: { name: skill.name }, props: { skill } }));
}

interface Props {
  skill: Skill;
}
const { skill } = Astro.props;
const refs = normas(skill);
const input = fixtureInput(skill);
const sourceUrl = `${REPO_URL}/tree/main/${skill.path}`;
---
<Base
  title={`${skill.name} — obraforge`}
  description={firstSentence(skill.description)}
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'SoftwareSourceCode', name: skill.name, description: skill.description, version: skill.version, license: 'https://opensource.org/license/mit', codeRepository: sourceUrl, inLanguage: 'pt-BR' },
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Skills', item: '/skills' }, { '@type': 'ListItem', position: 2, name: skill.name }] },
  ]}
>
  <div class="grid gap-8 md:grid-cols-[3fr_2fr] items-start">
    <section>
      <p class="font-mono text-xs uppercase tracking-wide text-ink-2"><a href={`/areas/${skill.area}`}>{skill.area}</a></p>
      <h1 class="mt-1 font-mono text-2xl md:text-3xl font-semibold break-words">{skill.name}</h1>
      <p class="mt-4 text-lg">{skill.description}</p>
      {skill.state === 'depreciada' && (
        <p class="mt-4 border-l-4 border-notice-ink bg-notice-bg text-notice-ink px-4 py-3">Depreciada: {skill.deprecationReason}</p>
      )}
    </section>
    <Carimbo skill={skill} />
  </div>

  <section class="mt-10" aria-labelledby="normas">
    <h2 id="normas" class="text-xl font-semibold">Normas citadas</h2>
    {refs.length === 0 ? (
      <p class="mt-2 text-ink-2">Esta skill não cita norma.</p>
    ) : (
      <ul class="mt-3 divide-y divide-line border-y border-line">
        {refs.map((ref) => (
          <li class="py-2 flex flex-wrap gap-x-3">
            <span class="font-mono font-semibold">{ref.key}</span>
            <span>{ref.title}</span>
            <span class="text-ink-2">{ref.year}</span>
            {/^https?:\/\//.test(ref.source) ? <a href={ref.source} rel="noopener noreferrer">fonte</a> : <span class="text-ink-2">{ref.source}</span>}
          </li>
        ))}
      </ul>
    )}
    <p class="mt-4 border-l-4 border-notice-ink bg-notice-bg text-notice-ink px-4 py-3">
      Esta skill não substitui o responsável técnico. O resultado deve ser conferido e assumido por profissional habilitado, com ART ou RRT quando exigido.
    </p>
  </section>

  <div class="mt-10"><Install skill={skill} /></div>

  <section class="mt-10" aria-labelledby="teste">
    <h2 id="teste" class="text-xl font-semibold">O caso de teste</h2>
    <p class="mt-2 text-ink-2">
      A skill é testada contra um caso inventado, sem dado real. Entrada:{' '}
      <a href={`${REPO_URL}/blob/main/${skill.path}/fixtures/${input}`} rel="noopener noreferrer" class="font-mono">fixtures/{input}</a>.
    </p>
    <details class="mt-3 border border-line px-4 py-2">
      <summary class="cursor-pointer py-3">Mostrar o que a skill precisa apontar</summary>
      <div class="prosa" set:html={renderMarkdown(expected(skill), skill.path)} />
    </details>
  </section>

  <section class="mt-10" aria-labelledby="inteira">
    <h2 id="inteira" class="text-xl font-semibold">A skill inteira</h2>
    <div class="prosa mt-2" set:html={renderMarkdown(skillBody(skill), skill.path)} />
    <p class="mt-4"><a href={sourceUrl} rel="noopener noreferrer">Ver no GitHub</a></p>
  </section>
</Base>
