---
import '../styles/global.css';
import { catalog, REPO_URL } from '../lib/catalog.js';

interface Props {
  title: string;
  description: string;
  jsonLd?: object | object[];
}
const { title, description, jsonLd } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// JSON-LD é bloco de dados, não script executável; o "<" é escapado para o texto nunca fechar a tag.
const ld = jsonLd === undefined ? undefined : JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {ld && <script type="application/ld+json" set:html={ld} />}
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:absolute focus:m-2 focus:p-2 bg-paper">Pular para o conteúdo</a>
    <header class="border-b border-line">
      <nav class="mx-auto max-w-5xl px-4 flex flex-wrap items-center gap-x-6 gap-y-2 py-3" aria-label="Principal">
        <a href="/" class="font-mono font-semibold text-ink no-underline text-lg">obraforge</a>
        <a href="/skills" class="py-2">Skills</a>
        <a href="/sobre" class="py-2">Sobre</a>
        <a href={REPO_URL} class="py-2" rel="noopener noreferrer">GitHub</a>
      </nav>
    </header>
    <main id="conteudo" class="mx-auto w-full max-w-5xl px-4 py-8 flex-1">
      <slot />
    </main>
    <footer class="border-t border-line text-sm text-ink-2">
      <div class="mx-auto max-w-5xl px-4 py-4 flex flex-wrap gap-x-6 gap-y-2">
        <span class="font-mono">catálogo v{catalog().version}</span>
        <span>Licença MIT</span>
        <a href={REPO_URL} rel="noopener noreferrer">Código</a>
        <a href={`${REPO_URL}/blob/main/SECURITY.md`} rel="noopener noreferrer">Segurança</a>
        <a href="/sobre#privacidade">Privacidade</a>
      </div>
    </footer>
  </body>
</html>
